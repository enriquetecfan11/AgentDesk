# ---------------------------------------------------------------------------
# AgentDesk — copia este fichero y ajusta los valores:
#
#   cp .env.example .env
#
# Regla: NUNCA uses "localhost" en APP_BASE_URL ni en DATABASE_URL. La app se
# consume desde otros dispositivos de la LAN y, más adelante, desde Proxmox.
# ---------------------------------------------------------------------------

# URL base de la instalación, TAL COMO la escribe el navegador.
# Ejemplos: http://192.168.1.50:3000 | http://macmini.tailXXXX.ts.net:3000
# Se usa para cookies (secure solo si empieza por https://), enlaces y CORS.
APP_BASE_URL=http://192.168.1.50:3000

# Interfaz del host donde se publica el puerto. 0.0.0.0 = toda la LAN.
HOST_BIND=0.0.0.0

# Puerto del host. El contenedor escucha siempre en 3000.
APP_PORT=3000

# ---------------------------------------------------------------------------
# Postgres 16 (contenedor "db")
# La contraseña se interpola dentro de DATABASE_URL, así que usa solo
# caracteres seguros para URL: A-Z a-z 0-9 . _ ~ -  (sin @ : / ? # $)
# ---------------------------------------------------------------------------
POSTGRES_USER=agentdesk
POSTGRES_PASSWORD=cambiame-por-algo-aleatorio
POSTGRES_DB=agentdesk

# Conexión DENTRO de la red de Docker: el host es el servicio "db".
DATABASE_URL=postgresql://agentdesk:cambiame-por-algo-aleatorio@db:5432/agentdesk

# Directorio de artefactos subidos, dentro del contenedor (volumen "uploads").
UPLOADS_DIR=/app/uploads
