# ---------------------------------------------------------------------------
# Copy to .env.local and fill in the real values.
#
# NEXT_PUBLIC_* vars are inlined into the browser bundle and are therefore
# public: never put a secret in a NEXT_PUBLIC_ name. The anon key is expected
# to be public, but it is NOT sufficient to protect this workspace — see the
# "Security model" section of README.md.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe to expose; access is gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" key. SERVER ONLY. Grants full bypass of RLS.
# Only the Next.js route handlers in app/api/** read this variable.
# Generate it with: supabase projects api-keys --project-ref <project-ref>
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase CLI only (not needed by the Next.js app or the Edge Functions).
# Used by `supabase link` / `supabase db push` / `supabase functions deploy`.
# ---------------------------------------------------------------------------
# Personal access token from https://supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref, the subdomain in your project URL
SUPABASE_PROJECT_REF=
# Database password, prompted by `supabase link` when not set
SUPABASE_DB_PASSWORD=